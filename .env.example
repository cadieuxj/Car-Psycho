# Database Configuration
POSTGRES_USER=carpsycho
POSTGRES_PASSWORD=carpsycho_dev_pass
POSTGRES_DB=carpsycho
DATABASE_URL=postgresql://carpsycho:carpsycho_dev_pass@localhost:5432/carpsycho

# ChromaDB Configuration
CHROMA_AUTH_PROVIDER=chromadb.auth.token.TokenAuthCredentialsProvider
CHROMA_AUTH_TOKEN=carpsycho_token
CHROMA_HEADER=X-Chroma-Token
CHROMA_URL=http://localhost:8000

# Redis Configuration
REDIS_URL=redis://localhost:6379

# T4 VM Configuration (Remote Training)
T4_VM_HOST=your-t4-vm-ip-or-hostname
T4_VM_USER=ubuntu
T4_VM_SSH_KEY_PATH=~/.ssh/id_rsa
T4_VM_PORT=22

# Ollama Configuration (on T4 VM or local)
OLLAMA_HOST=http://your-t4-vm-ip:11434

# API Keys for Teacher Models (PsychSteer)
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# Teacher Model Selection
TEACHER_MODEL=gpt-4o  # Options: gpt-4o, gpt-4-turbo, claude-3-5-sonnet-20241022

# Model Registry
HF_TOKEN=hf_your_huggingface_token
MODEL_STORAGE_PATH=/app/models

# Training Configuration
DEFAULT_BATCH_SIZE=4
DEFAULT_LEARNING_RATE=2e-4
DEFAULT_EPOCHS=3
GRADIENT_ACCUMULATION_STEPS=4

# RegMix Ratios (must sum to 100)
REGMIX_PUBLIC_GENERAL=40
REGMIX_CAR_DOMAIN=40
REGMIX_SYNTHETIC=20

# Security
SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# WebSocket
WS_HEARTBEAT_INTERVAL=30
WS_MESSAGE_QUEUE_SIZE=100
